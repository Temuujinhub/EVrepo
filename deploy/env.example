# EV Hub орчны тохиргоо — /opt/evhub/.env болгож хуулаад бөглөнө.
# install.sh үүнийг автоматаар үүсгэдэг (нууц утгуудыг generate хийж).

# ── DB ──────────────────────────────────────────────────────────────────
# ОДОО: WSS сервер (172.16.100.32) дээрх локал Postgres.
# ДАРАА DB серверт (172.16.100.33) салгахдаа зөвхөн энэ мөрийг солино:
#   EVHUB_DATABASE_URL=postgresql://evhub:НУУЦ@172.16.100.33:5432/evhub
EVHUB_DATABASE_URL=postgresql://evhub:CHANGE_ME@127.0.0.1:5432/evhub

# ── Сүлжээ ─────────────────────────────────────────────────────────────
EVHUB_HOST=127.0.0.1
EVHUB_PORT=8100
# Цэнэглэгчид харагдах гадаад hаяг (QR, лог, бичиг баримтад)
EVHUB_PUBLIC_WS_URL=ws://202.21.117.180:8080/ocpp/1.6

# ── Цэнэглэгчийн provision (анхны бүртгэл) ─────────────────────────────
# Шинэ цэнэглэгчийг HMI дээр нь энэ user/password-оор тохируулбал эхний
# BootNotification дээр автоматаар бүртгэгдэнэ (status=NEW).
# Дараа нь цэнэглэгч бүрд internal API-аар ӨӨРИЙН нууц үг олгоно.
EVHUB_PROVISION_USER=provision
EVHUB_PROVISION_PASSWORD=CHANGE_ME
EVHUB_AUTO_REGISTER=true

# ── Core (easy-parking) холболт ────────────────────────────────────────
# Данс/тооцооны бүх логик core дээр. Hub үйл явдлаа энэ хаяг руу push хийнэ.
EVHUB_CORE_URL=https://test.easy-parking.mn
EVHUB_CORE_API_KEY=CHANGE_ME

# ── Internal API (core → hub команд) ──────────────────────────────────
# core-ийн .env-ийн PARKING_EVHUB_API_KEY-тэй ИЖИЛ утга байна.
EVHUB_INTERNAL_API_KEY=CHANGE_ME

# ── Нууц утгын шифрлэлт (chargers.auth_pass_enc) ──────────────────────
# Үүсгэх: venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVHUB_SECRET_ENC_KEY=

# ── OCPP ───────────────────────────────────────────────────────────────
EVHUB_HEARTBEAT_INTERVAL=300
EVHUB_METER_SAMPLE_INTERVAL=10

EVHUB_LOG_LEVEL=INFO
